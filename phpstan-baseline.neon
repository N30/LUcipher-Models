parameters:
	ignoreErrors:
		-
			message: '#^Cannot call method fromData\(\) on class\-string\|object\.$#'
			identifier: method.nonObject
			count: 4
			path: src/Http/Controllers/Api/ApiResourceController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Livewire/Master.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: src/Observers/UserOwnershipObserver.php

		-
			message: '#^Access to protected property TModel of Illuminate\\Database\\Eloquent\\Model\:\:\$table\.$#'
			identifier: property.protected
			count: 1
			path: src/Scopes/UserOwnershipScope.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: src/Scopes/UserOwnershipScope.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: src/Scopes/UserOwnershipScope.php

		-
			message: '#^Variable \$user_id might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: src/Scopes/UserOwnershipScope.php

		-
			message: '#^Call to an undefined static method All1\\LuModels\\Services\\LuModels\:\:getUI\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: src/Services/LuModels.php

		-
			message: '#^Call to an undefined static method All1\\LuModels\\Services\\LuModels\:\:lu_mode_structure_helper\(\)\.$#'
			identifier: staticMethod.notFound
			count: 3
			path: src/Services/LuModels.php

		-
			message: '#^Call to an undefined static method All1\\LuModels\\Services\\LuModels\:\:make_menu\(\)\.$#'
			identifier: staticMethod.notFound
			count: 3
			path: src/Services/LuModels.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/View/Components/DynamicLayout.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
