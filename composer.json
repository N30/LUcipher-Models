{
	"name": "lucipher/models",
	"description": "LuCipher Models: generic model-driven CRUD engine for Laravel — one controller family serving web, REST, API and SPA routes from Eloquent model metadata.",
	"type": "library",
	"version": "3.0.1",
	"license": "proprietary",
	"require": {
		"php": "^8.2",
		"illuminate/support": "^11.0|^12.0",
		"illuminate/database": "^11.0|^12.0",
		"lucipher/unite": "^3.0"
	},
	"require-dev": {
		"hirethunk/verbs": "^0.9",
		"larastan/larastan": "^3.0",
		"laravel/pint": "^1.0",
		"livewire/flux": "^2.0",
		"livewire/livewire": "^4.0",
		"lorisleiva/laravel-actions": "^2.0",
		"orchestra/testbench": "^9.0|^10.0",
		"phpunit/phpunit": "^11.0"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../lu_unite",
			"options": {
				"symlink": true
			}
		}
	],
	"scripts": {
		"test": "phpunit",
		"coverage": "phpunit --coverage-text --coverage-html build/coverage/html",
		"lint": "pint --test",
		"lint:fix": "pint",
		"analyse": "phpstan analyse --memory-limit=1G"
	},
	"replace": {
		"n30/lu_models": "self.version",
		"all1/lu_models": "self.version"
	},
	"autoload": {
		"psr-4": {
			"All1\\LuModels\\": "src/",
			"All1\\LuModels\\Database\\Factories\\": "database/factories/",
			"All1\\LuModels\\Database\\Seeders\\": "database/seeders/"
		}
	},
	"minimum-stability": "stable",
	"extra": {
		"laravel": {
			"providers": [
				"All1\\LuModels\\Providers\\LuModelsServiceProvider"
			]
		}
	},
	"autoload-dev": {
		"psr-4": {
			"All1\\LuModels\\Tests\\": "tests/",
			"App\\": "tests/Fixtures/app/"
		}
	}
}
