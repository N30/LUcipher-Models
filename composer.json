{
    "name": "lucipher/models",
    "description": "LuCipher Models: generic model-driven CRUD engine for Laravel — one controller family serving web, REST, API and SPA routes from Eloquent model metadata.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "php": "^8.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "lucipher/unite": "LuCipher Universal multi-tenant bootstrap. Optional: the package registers its own config, views, components and routes.",
        "livewire/livewire": "Required only when lu::models.enable_spa_routes is on (the /spa transport is a Livewire component).",
        "livewire/flux": "The shipped blades use Flux components until the default theme lands.",
        "laravel/mcp": "Required by the MCP transport (lu::models.enable_mcp_routes)."
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text --coverage-html build/coverage/html",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "replace": {
        "n30/lu_models": "self.version",
        "all1/lu_models": "self.version"
    },
    "autoload": {
        "psr-4": {
            "All1\\LuModels\\": "src/",
            "All1\\LuModels\\Database\\Factories\\": "database/factories/",
            "All1\\LuModels\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "All1\\LuModels\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/app/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "All1\\LuModels\\Providers\\LuModelsServiceProvider"
            ]
        }
    }
}
